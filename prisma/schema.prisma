// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider = "prisma-client-js"
    output   = "../app/generated/prisma"
}

datasource db {
    provider = "mysql"
}

model Authcode {
	id String @id @default(uuid())
	discord_id String @unique
	email String
	code_hash String
	expiry DateTime
}

model Channel {
	id String @id @default(uuid())
	guild_id String
	channel_id String
	message_id String?

	@@unique([guild_id, channel_id])
}

model User {
	id String @id @default(uuid())
	discord_id String @unique
	email String @unique
	authenticated_at DateTime @default(now())
}

model Dispatcher {
	id String @id @default(dbgenerated("(UUID())"))
	name String
	shift_date DateTime
}

model Shift_Type {
	id Int @id @default(autoincrement())
	name String @unique
	shifts Shift[]
}

model Shift_Time {
	id Int @id @default(autoincrement())
	time String @unique
	shifts Shift[]
}

model Shift {
	id String @id @default(dbgenerated("(UUID())"))

	shift_type_name String
	shift_type Shift_Type @relation(fields: [shift_type_name], references: [name])

	shift_start_hour String
	shift_time Shift_Time @relation(fields: [shift_start_hour], references: [time])

	signed_up Int
	capacity Int
	shift_date DateTime
}

model Shift_Credit {
	id String @id @default(dbgenerated("(UUID())"))
	
	user_email String
	week DateTime
	credits Float?

	@@unique([user_email, week])
}